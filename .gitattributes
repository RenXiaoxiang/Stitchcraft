* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.bat text eol=crlf
*.txt text eol=lf

# Vendored third-party files are byte-for-byte upstream copies: never let Git
# normalize their line endings or encodings.
skills/vendor/** -text
designs/vendor/** -text
vendor/** -text
app/web/vendor/** -text
themes/**/sample/vendor/** -text
docs/demo/**/vendor/** -text
