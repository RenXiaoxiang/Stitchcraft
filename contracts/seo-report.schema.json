{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stitchcraft.dev/contracts/seo-report.schema.json",
  "title": "SEO Report",
  "description": "Sealed output of the Discovery module: metadata, structured data, sitemap and robots policy for the built site.",
  "type": "object",
  "required": ["meta", "sitemap", "robots"],
  "properties": {
    "meta": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "title", "description"],
        "properties": {
          "path": { "type": "string" },
          "title": { "type": "string" },
          "title_length": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" },
          "description_length": { "type": "integer", "minimum": 0 },
          "canonical": { "type": "string" },
          "og_image": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "structured_data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "type", "status"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" },
          "status": { "type": "string", "enum": ["valid", "invalid", "missing"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "sitemap": {
      "type": "object",
      "required": ["url", "included_paths"],
      "properties": {
        "url": { "type": "string" },
        "included_paths": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "robots": {
      "type": "object",
      "required": ["allow"],
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "disallow": { "type": "array", "items": { "type": "string" } },
        "sitemap_ref": { "type": "string" }
      },
      "additionalProperties": true
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "path", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "path": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
