{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stitchcraft.dev/contracts/deploy-plan.schema.json",
  "title": "Deploy Plan",
  "description": "Sealed output of the Ship It module: a reproducible deployment with environment, domain and rollback steps.",
  "type": "object",
  "required": ["target", "steps"],
  "properties": {
    "target": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "enum": ["cloudflare-pages", "vercel", "netlify", "github-pages", "self-hosted"] },
        "project": { "type": "string" },
        "domain": { "type": "string" },
        "preview_url": { "type": "string" }
      },
      "additionalProperties": true
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "source"],
        "properties": {
          "key": { "type": "string" },
          "source": { "type": "string", "enum": ["manual", "repo-secret", "provider-secret", "generated"] },
          "secret": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "command"],
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "command": { "type": "string" },
          "rollback": { "type": "string" },
          "verify": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "post_deploy_checks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rollback": {
      "type": "object",
      "properties": {
        "trigger": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
