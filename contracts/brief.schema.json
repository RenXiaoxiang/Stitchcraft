{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stitchcraft.dev/contracts/brief.schema.json",
  "title": "Brief",
  "description": "Sealed output of the Brief Intake module. Later modules read this instead of talking to the client.",
  "type": "object",
  "required": ["project", "audience", "goals"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "one_liner"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "one_liner": { "type": "string", "minLength": 8 },
        "domain": { "type": "string" }
      },
      "additionalProperties": true
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment", "needs"],
        "properties": {
          "segment": { "type": "string" },
          "needs": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "pattern": "^G[0-9]+$" },
          "statement": { "type": "string" },
          "metric": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "pages_hint": { "type": "array", "items": { "type": "string" } },
    "brand": {
      "type": "object",
      "properties": {
        "tone": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "assets": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "constraints": { "type": "object", "additionalProperties": true },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
