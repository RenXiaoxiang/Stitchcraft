{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stitchcraft.dev/contracts/build-manifest.schema.json",
  "title": "Build Manifest",
  "description": "Sealed output of the Site Assembly module: routes, components, assets and build settings for the static site.",
  "type": "object",
  "required": ["stack", "routes", "build"],
  "properties": {
    "stack": {
      "type": "object",
      "required": ["framework"],
      "properties": {
        "framework": { "type": "string", "enum": ["astro", "next-static", "sveltekit-static", "eleventy", "hugo", "plain-html"] },
        "css": { "type": "string" },
        "runtime": { "type": "string", "enum": ["static", "ssr", "hybrid"] },
        "package_manager": { "type": "string" }
      },
      "additionalProperties": true
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "file"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "file": { "type": "string" },
          "components": { "type": "array", "items": { "type": "string" } },
          "goal_id": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "file"],
        "properties": {
          "name": { "type": "string" },
          "file": { "type": "string" },
          "props": { "type": "array", "items": { "type": "string" } },
          "variants": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file"],
        "properties": {
          "file": { "type": "string" },
          "source": { "type": "string" },
          "alt": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "build": {
      "type": "object",
      "required": ["command", "output"],
      "properties": {
        "command": { "type": "string" },
        "output": { "type": "string" },
        "env": { "type": "array", "items": { "type": "string" } },
        "node_version": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
