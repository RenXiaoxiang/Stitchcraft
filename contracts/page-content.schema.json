{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stitchcraft.dev/contracts/page-content.schema.json",
  "title": "Page Content",
  "description": "Sealed output of the Copywriting module: every page section written, ordered and ready to render.",
  "type": "object",
  "required": ["pages"],
  "properties": {
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sections"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "title": { "type": "string" },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "type"],
              "properties": {
                "id": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["hero", "features", "showcase", "testimonials", "pricing", "faq", "cta", "footer", "rich-text"]
                },
                "headline": { "type": "string" },
                "subhead": { "type": "string" },
                "body": { "type": "array", "items": { "type": "string" } },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "cta": {
                  "type": "object",
                  "properties": {
                    "label": { "type": "string" },
                    "href": { "type": "string" }
                  },
                  "additionalProperties": true
                },
                "media": {
                  "type": "object",
                  "properties": {
                    "alt": { "type": "string" },
                    "src": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "nav_labels": { "type": "array", "items": { "type": "string" } },
        "footer": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "meta": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "title", "description"],
        "properties": {
          "path": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
